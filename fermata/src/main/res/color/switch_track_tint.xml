<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- On: the accent. Off: the dim control colour at low strength, nothing in the accent colour. -->
    <item android:alpha="1" android:color="?attr/colorControlActivated" android:state_checked="true" />
    <item android:alpha="0.3" android:color="?attr/colorControlNormal" android:state_checked="false" />
</selector>
