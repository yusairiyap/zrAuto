<?xml version="1.0" encoding="utf-8"?>
<!-- The Timeline's title, with the date range it shows as a chip that opens the range picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:text="@string/fuel_log_timeline"
        android:textColor="?attr/musicTextPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fuel_log_timeline_date_range"
        style="@style/MusicChip"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:drawableStart="@drawable/clock"
        android:textSize="13sp"
        tools:text="17 Aug – 17 Sep 2026" />
</LinearLayout>
