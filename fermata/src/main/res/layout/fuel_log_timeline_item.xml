<?xml version="1.0" encoding="utf-8"?>
<!-- ConstraintLayout, not a horizontal LinearLayout: the road/dot column's height needs to match
     the card's, and the card's own height is wrap_content, driven by however many lines its
     text ends up taking. A LinearLayout child can't stretch to "whatever height my wrap_content
     sibling ends up being" in one measure pass (a match_parent child of a wrap_content
     LinearLayout just collapses to its own content instead); constraining the road's top+bottom
     to the parent's is the standard way to get that "match this sibling's height" behavior. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <me.aap.fermata.ui.view.TimelineRoadView
        android:id="@+id/fuel_log_timeline_road"
        android:layout_width="40dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/fuel_log_timeline_dot"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/timeline_dot_bg_refuel"
        android:padding="6dp"
        android:src="@drawable/fuel"
        app:layout_constraintBottom_toBottomOf="@id/fuel_log_timeline_road"
        app:layout_constraintEnd_toEndOf="@id/fuel_log_timeline_road"
        app:layout_constraintStart_toStartOf="@id/fuel_log_timeline_road"
        app:layout_constraintTop_toTopOf="@id/fuel_log_timeline_road"
        app:tint="@android:color/white" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fuel_log_timeline_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fuel_log_timeline_road"
        app:layout_constraintTop_toTopOf="parent"
        app:rippleColor="?attr/rippleColor">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/fuel_log_timeline_event"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:textStyle="bold"
                    tools:text="Trip Started" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/fuel_log_timeline_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="?attr/textAppearanceCaption"
                    tools:text="5:30 PM" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fuel_log_timeline_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceBody2"
                app:drawableStartCompat="@drawable/speed"
                app:drawableTint="?attr/colorOnSecondary"
                tools:text="87.2 km" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fuel_log_timeline_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceBody2"
                app:drawableStartCompat="@drawable/distance"
                app:drawableTint="?attr/colorOnSecondary"
                tools:text="Shell Station, Main St" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
