<?xml version="1.0" encoding="utf-8"?>
<!-- ConstraintLayout, not a horizontal LinearLayout: the road/dot column's height needs to match
     the card's, and the card's own height is wrap_content, driven by however many lines its
     text ends up taking. A LinearLayout child can't stretch to "whatever height my wrap_content
     sibling ends up being" in one measure pass (a match_parent child of a wrap_content
     LinearLayout just collapses to its own content instead); constraining the road's top+bottom
     to the parent's is the standard way to get that "match this sibling's height" behavior. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <me.aap.fermata.ui.view.TimelineRoadView
        android:id="@+id/fuel_log_timeline_road"
        android:layout_width="40dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/fuel_log_timeline_dot"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/timeline_dot_bg_refuel"
        android:padding="6dp"
        android:src="@drawable/fuel"
        app:layout_constraintBottom_toBottomOf="@id/fuel_log_timeline_road"
        app:layout_constraintEnd_toEndOf="@id/fuel_log_timeline_road"
        app:layout_constraintStart_toStartOf="@id/fuel_log_timeline_road"
        app:layout_constraintTop_toTopOf="@id/fuel_log_timeline_road"
        app:tint="@android:color/white" />

    <!-- A flat rounded card like the Data Usage tab's (see fuel_log_card_bg), in the Music
         palette that FuelLogFragment inflates this tab with. -->
    <LinearLayout
        android:id="@+id/fuel_log_timeline_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/fuel_log_card_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fuel_log_timeline_road"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fuel_log_timeline_event"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/musicTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Trip Started" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/fuel_log_timeline_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/musicTextSecondary"
                android:textSize="12sp"
                tools:text="5:30 PM" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/fuel_log_timeline_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textColor="?attr/musicTextSecondary"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/speed"
            app:drawableTint="?attr/musicIconSecondary"
            tools:text="87.2 km" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/fuel_log_timeline_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textColor="?attr/musicTextSecondary"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/distance"
            app:drawableTint="?attr/musicIconSecondary"
            tools:text="Shell Station, Main St" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
