<?xml version="1.0" encoding="utf-8"?>
<!--
  The page is one RecyclerView, built in DiagnosticLogFragment: the first item is the header (version,
  recording switch, buttons, search, level and category filters), the others are the log's lines. The
  RecyclerView is what gets MainActivityDelegate#insetScrollableContent(): tool_bar, control_panel and
  nav_bar are drawn as translucent overlays on top of fragment content, so the padding that keeps the
  first and last item clear of them has to sit on the scrolling view itself, with the content scrolling
  under the bars. The header scrolls away with the list for the same reason: the bars give way to it
  (ScrollBarsController) like to any list.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/diagnostic_log_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="vertical" />

<!--
  Back to the top (the header and, with Newest first, the newest entries), shown only once scrolled away
  from it. A plain Material floating button, which the app's theme gives the same look as the back button
  (not the app's own FloatingButton class, which takes its icon from the active tab). Lifted above the
  back button in DiagnosticLogFragment.
-->
<com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/diagnostic_log_top"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_marginEnd="15dp"
    android:contentDescription="@string/diagnostic_log_top"
    android:elevation="10dp"
    android:src="@drawable/move_to_top"
    android:visibility="gone" />
</FrameLayout>
