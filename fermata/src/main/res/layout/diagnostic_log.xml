<?xml version="1.0" encoding="utf-8"?>
<!--
  Root is the ViewGroup handed to MainActivityDelegate#insetScrollableContent() (see
  DiagnosticLogFragment), not the ScrollView below it: tool_bar/control_panel/nav_bar are drawn as
  translucent overlays on top of fragment content, so the action row has to be pushed clear of them
  too, not just the log text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/diagnostic_log_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!--
          A plain platform ?android:attr/buttonBarButtonStyle used to sit here: its text color
          comes from the platform's own theme rather than this app's Material one, and on this
          screen's dark background that resolved to a barely-visible dark-on-dark label. The
          Material3 text-button style is driven by this app's own (per-theme-correct) colorPrimary
          instead, same as everywhere else in the app that needs a themed, always-legible label.
        -->
        <Button
            android:id="@+id/diagnostic_log_copy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorPrimary"
            android:text="@string/diagnostic_log_copy" />

        <Button
            android:id="@+id/diagnostic_log_share"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorPrimary"
            android:text="@string/diagnostic_log_share" />

        <Button
            android:id="@+id/diagnostic_log_refresh"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorPrimary"
            android:text="@string/diagnostic_log_refresh" />

        <Button
            android:id="@+id/diagnostic_log_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorPrimary"
            android:text="@string/diagnostic_log_clear" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/diagnostic_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/diagnostic_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace" />
    </ScrollView>
</LinearLayout>
