<?xml version="1.0" encoding="utf-8"?>
<!-- The Data Usage tab, see DataUsageFragment. One scrolling column: the usage ring with the
     limit figures, the settings chip, the Overall / Day / Week / Month switch with the period
     navigation, the bar chart, and the breakdown by category. Inflated with the Music tab's
     palette (MusicPalette in music.xml), so both tabs share one look. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/data_usage_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/musicBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Usage this cycle -->
        <LinearLayout
            style="@style/DataUsageCard"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/data_usage_cycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/musicTextSecondary"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_marginTop="10dp">

                <me.aap.fermata.ui.view.DataUsageRingView
                    android:id="@+id/data_usage_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/data_usage"
                        android:tint="?attr/musicIconSecondary" />

                    <TextView
                        android:id="@+id/data_usage_used"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:singleLine="true"
                        android:textColor="?attr/musicTextPrimary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/data_usage_used_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="?attr/musicTextSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/data_usage_status"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/data_usage_status_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/data_usage_remaining"
                        style="@style/DataUsageStatValue" />

                    <TextView
                        style="@style/DataUsageStatCaption"
                        android:text="@string/data_usage_remaining" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/musicSeekTrack" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/data_usage_limit"
                        style="@style/DataUsageStatValue" />

                    <TextView
                        style="@style/DataUsageStatCaption"
                        android:text="@string/data_usage_limit" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/musicSeekTrack" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/data_usage_warning"
                        style="@style/DataUsageStatValue" />

                    <TextView
                        style="@style/DataUsageStatCaption"
                        android:text="@string/data_usage_warning" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Same chips as the Music tab's (queue, effects, video). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/data_usage_settings"
                style="@style/MusicChip"
                android:drawableStart="@drawable/settings"
                android:text="@string/data_usage_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/data_usage_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/data_usage_segment_bg"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/data_usage_filter_overall"
                style="@style/DataUsageSegment"
                android:text="@string/data_usage_overall" />

            <TextView
                android:id="@+id/data_usage_filter_day"
                style="@style/DataUsageSegment"
                android:text="@string/data_usage_day" />

            <TextView
                android:id="@+id/data_usage_filter_week"
                style="@style/DataUsageSegment"
                android:text="@string/data_usage_week" />

            <TextView
                android:id="@+id/data_usage_filter_month"
                style="@style/DataUsageSegment"
                android:text="@string/data_usage_month" />
        </LinearLayout>

        <!-- The chart and the period it shows, with arrows to go back and forth. -->
        <LinearLayout
            style="@style/DataUsageCard"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/data_usage_prev"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/data_usage_previous"
                    android:src="@drawable/data_usage_chevron_left"
                    android:tint="?attr/musicIconPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/data_usage_period"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="?attr/musicTextPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/data_usage_period_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:textColor="?attr/musicTextSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/data_usage_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/data_usage_next"
                    android:src="@drawable/data_usage_chevron_right"
                    android:tint="?attr/musicIconPrimary" />
            </LinearLayout>

            <me.aap.fermata.ui.view.DataUsageChartView
                android:id="@+id/data_usage_chart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/data_usage_chart_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/data_usage_chart_hint"
                android:textColor="?attr/musicTextTertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- What the data went on, for the period above. -->
        <LinearLayout
            style="@style/DataUsageCard"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/data_usage_breakdown"
                android:textColor="?attr/musicTextPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/data_usage_row_video"
                layout="@layout/data_usage_row" />

            <include
                android:id="@+id/data_usage_row_music"
                layout="@layout/data_usage_row" />

            <include
                android:id="@+id/data_usage_row_other"
                layout="@layout/data_usage_row" />
        </LinearLayout>

        <TextView
            android:id="@+id/data_usage_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="?attr/musicTextTertiary"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
