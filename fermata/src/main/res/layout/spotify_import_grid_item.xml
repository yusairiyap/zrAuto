<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/si_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/si_thumb"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/media_item_grid_scrim"
                app:layout_constraintBottom_toBottomOf="@id/si_thumb"
                app:layout_constraintEnd_toEndOf="@id/si_thumb"
                app:layout_constraintStart_toStartOf="@id/si_thumb"
                app:layout_constraintTop_toTopOf="@id/si_thumb" />

            <ProgressBar
                android:id="@+id/si_thumb_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/si_thumb"
                app:layout_constraintEnd_toEndOf="@id/si_thumb"
                app:layout_constraintStart_toStartOf="@id/si_thumb"
                app:layout_constraintTop_toTopOf="@id/si_thumb" />

            <ImageView
                android:id="@+id/si_check"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:background="@drawable/spotify_import_badge_bg"
                android:contentDescription="@string/select"
                android:padding="8dp"
                android:src="@drawable/check_box"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@android:color/white" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/si_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/spotify_status_bg"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="@android:color/white"
                android:visibility="gone"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@id/si_check"
                app:layout_constraintStart_toEndOf="@id/si_check"
                app:layout_constraintTop_toTopOf="@id/si_check" />

            <ImageView
                android:id="@+id/si_search_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:background="@drawable/spotify_import_badge_bg"
                android:contentDescription="@string/spotify_import_search_more"
                android:padding="9dp"
                android:src="@drawable/search"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@android:color/white" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/si_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#B0000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textAppearance="?attr/textAppearanceBody1"
                android:textColor="@android:color/white"
                app:layout_constraintBottom_toTopOf="@id/si_subtitle"
                app:layout_constraintEnd_toEndOf="@id/si_thumb"
                app:layout_constraintStart_toStartOf="@id/si_thumb" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/si_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:shadowColor="#B0000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="@android:color/white"
                app:layout_constraintBottom_toTopOf="@id/si_detail"
                app:layout_constraintEnd_toEndOf="@id/si_thumb"
                app:layout_constraintStart_toStartOf="@id/si_thumb" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/si_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:alpha="0.8"
                android:ellipsize="end"
                android:singleLine="true"
                android:shadowColor="#B0000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="@android:color/white"
                app:layout_constraintBottom_toBottomOf="@id/si_thumb"
                app:layout_constraintEnd_toEndOf="@id/si_thumb"
                app:layout_constraintStart_toStartOf="@id/si_thumb" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
