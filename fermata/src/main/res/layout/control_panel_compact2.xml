<?xml version="1.0" encoding="utf-8"?>
<!-- The control panel's compact look on a narrow screen (a phone) while browsing the tabs, where
control_panel_compact.xml's single line doesn't fit: the art, title and transport buttons on top,
the seek bar between its time labels under them.
Only the constraints are read from here (ControlPanelView#applyLayout); the views themselves come
from control_panel_view.xml, and their visibility and sizes are set in code. Never used in
fullscreen video, which keeps control_panel_view.xml / control_panel_view2.xml. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/control_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@id/control_prev"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/control_play_pause"
        app:layout_constraintTop_toTopOf="@id/control_play_pause" />

    <View
        android:id="@+id/control_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toStartOf="@id/control_rw"
        app:layout_constraintStart_toEndOf="@id/control_info"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/control_rw"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toStartOf="@id/control_play_pause"
        app:layout_constraintStart_toEndOf="@id/control_prev"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/control_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toStartOf="@id/control_ff"
        app:layout_constraintStart_toEndOf="@id/control_rw"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/control_ff"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toStartOf="@id/control_next"
        app:layout_constraintStart_toEndOf="@id/control_play_pause"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/control_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/control_ff"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/show_hide_bars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/seek_bar"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrier" />

    <View
        android:id="@+id/seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/show_hide_bars"
        app:layout_constraintEnd_toStartOf="@id/control_menu_button"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintStart_toEndOf="@id/show_hide_bars"
        app:layout_constraintTop_toTopOf="@id/show_hide_bars" />

    <View
        android:id="@+id/control_menu_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/show_hide_bars"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/seek_bar"
        app:layout_constraintTop_toTopOf="@id/show_hide_bars" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="control_play_pause" />

</merge>
