<?xml version="1.0" encoding="utf-8"?>
<!-- Covers the video when playback was paused for reaching the data limit; a tap anywhere carries
     on past the limit. See DataUsageAlerts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/data_usage_gate_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/data_usage_gate_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/data_usage_gate_icon_bg"
            android:importantForAccessibility="no"
            android:padding="18dp"
            android:src="@drawable/data_usage"
            android:tint="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/data_usage_gate_title"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/data_usage_gate_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="420dp"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/data_usage_gate_button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/data_usage_pill_bg"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/data_usage_gate_tap"
            android:textColor="#FF000000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="420dp"
            android:text="@string/data_usage_gate_note"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
