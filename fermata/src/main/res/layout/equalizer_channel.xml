<?xml version="1.0" encoding="utf-8"?>
<!-- One slider of the effects screens, on two lines so the slider itself gets the full width: the
     label (with its switch, if it has one) and the value on top; below, a minus button, the slider
     and a plus button. The round buttons step the slider (hold to keep going), so a value can be set
     with taps alone, which is a lot easier in a car than dragging a thumb; see StepSeekBar.
     Inflated with the Music tab's palette (see EffectsUi). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/eq_channel_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:textColor="?attr/musicTextPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/eq_channel_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end|center_vertical"
            android:lines="1"
            android:textColor="?attr/musicTextSecondary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/eq_channel_switch"
            style="?attr/appEqualizerStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/eq_channel_minus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/step_button_bg"
            android:contentDescription="@string/eq_step_down"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/step_minus"
            android:tint="?attr/musicIconPrimary" />

        <me.aap.fermata.ui.view.StepSeekBar
            android:id="@+id/eq_channel_seek"
            style="?attr/appEqualizerStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/eq_channel_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/step_button_bg"
            android:contentDescription="@string/eq_step_up"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/step_plus"
            android:tint="?attr/musicIconPrimary" />
    </LinearLayout>
</LinearLayout>
