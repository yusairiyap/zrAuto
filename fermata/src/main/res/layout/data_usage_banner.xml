<?xml version="1.0" encoding="utf-8"?>
<!-- The data warning / limit banner shown at the top of every tab and over fullscreen video, see
     DataUsageAlerts. An in-app view rather than a toast, so it shows on Android Auto too. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/data_usage_banner_bg"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/data_usage_banner_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/data_usage_dot"
        android:importantForAccessibility="no"
        android:padding="7dp"
        android:src="@drawable/data_usage" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/data_usage_banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/data_usage_banner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/data_usage_banner_action"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/data_usage_pill_bg"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/data_usage_banner_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/data_usage_dismiss"
        android:padding="10dp"
        android:scaleType="fitCenter" />
</LinearLayout>
