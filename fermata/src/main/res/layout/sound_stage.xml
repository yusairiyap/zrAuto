<?xml version="1.0" encoding="utf-8"?>
<!-- The sound stage card of the effects screens, see SoundStageView: stereo width, differential
     surround and the 3D speaker pad, each with its own switch. The slider rows are added in code
     (equalizer_channel.xml) into the stage_*_rows containers. Inflated with the Music tab's palette
     (see EffectsUi). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stage_title"
        android:textColor="?attr/musicTextPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />


    <!-- Stereo width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/stage_width"
            android:textColor="?attr/musicTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/stage_width_switch"
            style="?attr/appEqualizerStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stage_width_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="?attr/musicSeekTrack" />

    <!-- Differential surround -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/stage_diff"
            android:textColor="?attr/musicTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/stage_diff_switch"
            style="?attr/appEqualizerStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stage_diff_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="?attr/musicSeekTrack" />

    <!-- 3D speaker -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/stage_3d"
            android:textColor="?attr/musicTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/stage_pos_switch"
            style="?attr/appEqualizerStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stage_3d_hint"
        android:textColor="?attr/musicTextSecondary"
        android:textSize="12sp" />

    <me.aap.fermata.ui.view.StagePadView
        android:id="@+id/stage_pad"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/stage_pos_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/stage_pos_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />
</merge>
