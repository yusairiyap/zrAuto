<?xml version="1.0" encoding="utf-8"?>
<!-- The audio effects screen (AudioEffectsView, and YouTube's YoutubeEqualizerView): one scrolling
     column of cards in the Music tab's palette, like the Music and Data Usage tabs. The effects
     first, then the equalizer, the sound stage (width, differential surround, 3D speaker), and
     where the settings apply. Every slider has round minus / plus buttons (see
     equalizer_channel.xml), and the equalizer has buttons that move all of its bands together, so
     it can all be operated with taps. Inflated with the palette (see EffectsUi). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- ====================== Effects ====================== -->
    <LinearLayout
        android:id="@+id/effects_card"
        style="@style/DataUsageCard"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/effects_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center_vertical"
            android:text="@string/effects"
            android:textColor="?attr/musicTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <me.aap.utils.pref.PreferenceView
            android:id="@+id/virtualizer_mode"
            style="?attr/appEqualizerStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/focusable_shape_transparent"
            android:focusable="true"
            tools:ignore="RtlSymmetry" />

        <LinearLayout
            android:id="@+id/equalizer_effects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- ====================== Equalizer ====================== -->
    <LinearLayout
        android:id="@+id/equalizer_header"
        style="@style/DataUsageCard"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/equalizer_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/equalier"
                android:textColor="?attr/musicTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/equalizer_switch"
                style="?attr/appEqualizerStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/focusable_shape_transparent"
                android:focusable="true"
                android:nextFocusDown="@id/equalizer_preset"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:scaleX="1.3"
                android:scaleY="1.3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/preset_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/preset_label"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="@string/preset"
                android:textColor="?attr/musicTextPrimary"
                android:textSize="14sp" />

            <me.aap.utils.pref.PreferenceView
                android:id="@+id/equalizer_preset"
                style="?attr/appEqualizerStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/focusable_shape_transparent"
                android:focusable="true"
                android:nextFocusUp="@id/equalizer_switch"
                android:paddingStart="8dp"
                tools:ignore="RtlSymmetry" />

            <me.aap.utils.ui.view.ImageButton
                android:id="@+id/equalizer_preset_save"
                style="?attr/appEqualizerStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/focusable_shape_transparent"
                android:focusable="true"
                android:nextFocusUp="@id/equalizer_switch"
                android:scaleType="fitCenter"
                android:src="@drawable/save"
                android:visibility="gone" />

            <me.aap.utils.ui.view.ImageButton
                android:id="@+id/equalizer_preset_delete"
                style="?attr/appEqualizerStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/focusable_shape_transparent"
                android:focusable="true"
                android:scaleType="fitCenter"
                android:src="@drawable/delete"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Move every band at once: one dB down or up, or back to flat. -->
        <LinearLayout
            android:id="@+id/eq_group_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/eq_all_down"
                style="@style/MusicChip"
                android:layout_width="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/eq_all_down" />

            <TextView
                android:id="@+id/eq_all_up"
                style="@style/MusicChip"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/eq_all_up" />

            <TextView
                android:id="@+id/eq_reset"
                style="@style/MusicChip"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/eq_reset" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/equalizer_channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- ====================== Sound stage ====================== -->
    <me.aap.fermata.ui.view.SoundStageView
        android:id="@+id/sound_stage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" />

    <!-- ====================== Apply to ====================== -->
    <LinearLayout
        android:id="@+id/apply_to"
        style="@style/DataUsageCard">

        <TextView
            android:id="@+id/apply_to_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center_vertical"
            android:text="@string/apply_to"
            android:textColor="?attr/musicTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <me.aap.utils.pref.PreferenceView
            android:id="@+id/track"
            style="?attr/appEqualizerStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/focusable_shape_transparent"
            android:focusable="true"
            android:paddingStart="5dp"
            tools:ignore="RtlSymmetry" />

        <me.aap.utils.pref.PreferenceView
            android:id="@+id/folder"
            style="?attr/appEqualizerStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/focusable_shape_transparent"
            android:focusable="true"
            android:paddingStart="5dp"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>
</LinearLayout>
