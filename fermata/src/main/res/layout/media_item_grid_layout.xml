<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Full-bleed thumbnail/icon: fills the whole card, height derived from width so the card
         itself (wrap_content) sizes to it; title/subtitle/badge below are overlaid on top of it
         rather than adding their own row height, matching the Android TV "compact card" style. -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/media_item_icon"
        style="?attr/appMediaItemStyle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/media_item_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/media_item_grid_scrim"
        app:layout_constraintBottom_toBottomOf="@id/media_item_icon"
        app:layout_constraintEnd_toEndOf="@id/media_item_icon"
        app:layout_constraintTop_toTopOf="@id/media_item_icon"
        app:layout_constraintStart_toStartOf="@id/media_item_icon" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/media_item_title"
        style="?attr/appMediaItemStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="2dp"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:shadowColor="#B0000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        app:layout_constraintBottom_toTopOf="@id/media_item_subtitle"
        app:layout_constraintEnd_toEndOf="@id/media_item_icon"
        app:layout_constraintStart_toStartOf="@id/media_item_icon"
        app:layout_goneMarginBottom="10dp"
        tools:ignore="RtlSymmetry" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/media_item_subtitle"
        style="?attr/appMediaItemStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@android:color/white"
        android:shadowColor="#B0000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        app:layout_constraintBottom_toTopOf="@id/media_stream_progress"
        app:layout_constraintEnd_toEndOf="@id/media_item_icon"
        app:layout_constraintStart_toStartOf="@id/media_item_icon"
        tools:ignore="RtlSymmetry" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/media_stream_progress"
        style="?attr/appStreamProgressStyle"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/media_item_icon"
        app:layout_constraintEnd_toEndOf="@id/media_item_icon"
        app:layout_constraintStart_toStartOf="@id/media_item_icon" />

    <!-- Same look as the Spotify import cards: the box icon, white, on a dark round badge at the
         top-left, so it stays visible over any thumbnail. The icons are inset drawables so they
         sit centred in the badge (a CheckBox draws its button at its start edge). -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/media_item_checkbox"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="6dp"
        android:background="@drawable/spotify_import_badge_bg"
        android:button="@drawable/media_item_check"
        android:elevation="10dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        app:buttonIcon="@android:color/transparent"
        app:buttonTint="@android:color/white"
        app:useMaterialThemeColors="false"
        app:layout_constraintStart_toStartOf="@id/media_item_icon"
        app:layout_constraintTop_toTopOf="@id/media_item_icon" />

</merge>
