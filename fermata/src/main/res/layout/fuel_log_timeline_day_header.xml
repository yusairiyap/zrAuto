<?xml version="1.0" encoding="utf-8"?>
<!-- A day-group divider within the Timeline (e.g. "Today"/"Yesterday"/"Thursday, 24 Sept") so each
     event card underneath only needs to show its own time instead of repeating the date on every
     card. Left margin roughly aligns it with the road/dot column of the item rows above/below it. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="4dp"
    android:textColor="?attr/musicTextSecondary"
    android:textSize="13sp"
    android:textStyle="bold"
    tools:text="Today" />
