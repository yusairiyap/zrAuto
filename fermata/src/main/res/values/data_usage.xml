<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Data Usage tab's category colours: YouTube videos, YouTube music mode, other data. -->
    <color name="data_usage_video">#FFFF5A4E</color>
    <color name="data_usage_music">#FF1ED760</color>
    <color name="data_usage_other">#FF5B8DEF</color>
    <!-- Status colours: under the warning, past the warning, past the limit. -->
    <color name="data_usage_ok">#FF1ED760</color>
    <color name="data_usage_warning">#FFFFB020</color>
    <color name="data_usage_limit">#FFFF5252</color>

    <style name="DataUsageCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/data_usage_card_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="DataUsageSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/data_usage_segment_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/musicTextPrimary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DataUsageStatValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/musicTextPrimary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DataUsageStatCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/musicTextSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
