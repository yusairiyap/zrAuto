<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Black">

        <item name="android:colorBackground">#000000</item>
        <item name="android:editTextColor">#FFFFFF</item>

        <!-- Status bar-->
        <item name="colorPrimaryDark">#000000</item>

        <!-- Tool/Nav bars -->
        <item name="colorPrimary">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>

        <!-- List/Media items -->
        <item name="colorSecondary">#000000</item>
        <item name="colorOnSecondary">#6A6A6A</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="boxStrokeColor">#6A6A6A</item>

        <!-- Active media item -->
        <item name="alpha">0.7</item>
        <item name="colorSecondaryVariant">#6A6A6A</item>
        <item name="android:textColorTertiary">#FFFFFF</item>

        <!-- Popup menu -->
        <item name="colorSurface">#242424</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorPrimarySurface">#000000</item>
        <item name="colorOnPrimarySurface">#FFFFFF</item>

        <item name="colorAccent">#FFFFFF</item>
        <item name="rippleColor">#6A6A6A</item>

        <item name="android:textColorHint">#6A6A6A</item>

        <item name="colorControlNormal">#FFFFFF</item>
        <item name="colorControlActivated">#FFFFFF</item>

        <!-- Material 3 roles -->
        <item name="colorSurfaceVariant">#242424</item>
        <item name="colorOnSurfaceVariant">#FFFFFF</item>
        <item name="colorOutline">#FFFFFF</item>
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorErrorContainer">#93000A</item>
        <item name="colorOnErrorContainer">#FFDAD6</item>

        <item name="appSeekBarStyle">@style/AppTheme.Black.SeekBarStyle</item>

    </style>

    <!-- colorControlActivated/colorControlNormal/colorAccent are all pure white here, so the stock
    seek bar style painted the played part, the buffered part and the rest of the track in the
    same white and the position was hard to read. A grey played part on a darker remaining track
    keeps the white thumb standing out. -->
    <style name="AppTheme.Black.SeekBarStyle" parent="AppTheme.SeekBarStyle">
        <item name="android:progressTint">#9E9E9E</item>
        <item name="android:secondaryProgressTint">#5E5E5E</item>
        <item name="android:progressBackgroundTint">#3A3A3A</item>
    </style>

</resources>
