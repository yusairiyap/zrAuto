<?xml version="1.0" encoding="utf-8"?>
<!-- The Settings category showing in the right pane of the tablet layout: the row's card with an accent outline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/rippleColor">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="?attr/rippleColor" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceVariant" />
            <stroke android:width="2dp" android:color="?attr/colorControlActivated" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</ripple>
