                android:right="8dp"
                android:top="8dp" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:drawable="@drawable/spotify_import_badge_bg" />
            <item
                android:bottom="8dp"
                android:drawable="@drawable/media_item_check_box_blank_white"
                android:left="8dp"
                android:right="8dp"
                android:top="8dp" />
        </layer-list>
    </item>
</selector>
