<?xml version="1.0" encoding="utf-8"?>
<!-- Full-card scrim behind the white title/subtitle overlaid on the icon/thumbnail at the bottom.
     Two earlier versions of this only covered a fraction of the card's height
     (media_item_grid_layout.xml's media_item_scrim view is now constrained to the icon's full
     top-to-bottom span, not a percentage of it): whatever opacity this drawable started at its
     own top edge showed up as a hard, visibly abrupt line partway down the card, right where the
     un-scrimmed thumbnail met the scrim. Spanning the whole card removes that seam: there's
     nothing above this view for a boundary to show against, so the gradient can fade smoothly
     from fully transparent at the very top (the thumbnail's own top edge) down to strongly opaque
     at the bottom, while still keeping the title/subtitle's own region (the bottom ~35-40%,
     see media_item_grid_layout.xml) dark enough to read regardless of how bright or busy the
     thumbnail underneath is. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F2000000"
        android:centerColor="#66000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
