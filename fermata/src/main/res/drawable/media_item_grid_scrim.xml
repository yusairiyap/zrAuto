<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-anchored scrim for grid cards: fully opaque black at the card's bottom edge fading to
     transparent toward the top, so the white title/subtitle overlaid on it stay legible against
     any thumbnail. android:angle="90" draws the gradient from bottom (startColor) to top
     (endColor). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#E6000000"
        android:centerColor="#73000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
