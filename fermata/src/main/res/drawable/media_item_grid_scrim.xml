<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-anchored scrim for grid cards, behind the white title/subtitle overlaid on it.
     Previously faded from opaque at the card's bottom edge to fully transparent at this view's
     own top edge (android:angle="90" draws start-to-end as bottom-to-top): the title/subtitle
     text block sits close to that top edge (see media_item_grid_layout.xml's
     height_percent="0.6" on this view), so the title in particular ended up over little more
     than a faint tint, fine against a plain dark thumbnail, but against a bright, colorful cover
     (album art, a light photo) the white text all but disappeared. endColor is now dark enough on
     its own (55% opaque) that the whole band stays legible regardless of what's underneath;
     startColor/centerColor keep the bottom noticeably darker still so there's some depth to the
     scrim rather than a single flat tint. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F2000000"
        android:centerColor="#DE000000"
        android:endColor="#8C000000"
        android:type="linear" />
</shape>
