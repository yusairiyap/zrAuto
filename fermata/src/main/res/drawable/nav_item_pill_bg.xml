<?xml version="1.0" encoding="utf-8"?>
<!-- A nav bar tab's press/hover/focus highlight: the same inset pill shape as the sliding
     selection indicator FermataNavBarView draws, instead of focusable_shape_transparent's box. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/rippleColor">
    <item android:id="@android:id/mask">
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>

    <item android:id="@android:id/background">
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <stroke
                    android:width="?attr/boxStrokeWidth"
                    android:color="@color/focus_color" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>
</ripple>
